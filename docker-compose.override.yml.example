# Copia questo file in docker-compose.override.yml e personalizzalo.
# Docker Compose lo fonde automaticamente con docker-compose.yml.
# Il file docker-compose.override.yml è gitignored: le tue modifiche
# non causeranno mai conflitti durante i git pull.
#
# Esempio di utilizzo:
#   cp docker-compose.override.yml.example docker-compose.override.yml

services:
  shri-tools:
    # Personalizza PUID/PGID con i tuoi UID/GID (comando: id -u && id -g)
    # TZ imposta il fuso orario del container (default Etc/UTC) così gli orari
    # mostrati nell'app corrispondono all'ora locale. Elenco fusi validi:
    # https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Rome

    # Personalizza i percorsi dei volumi con le tue directory
    volumes:
      - ./data:/data
      - ./media:/media        # oppure: /mnt/nas/video:/media
      - ./output:/output      # oppure: /mnt/nas/output:/output

    # Personalizza le porte se necessario.
    # 6080 = accesso da browser (noVNC): basta questa per l'uso normale.
    # 5901 = VNC nativo: opzionale, solo se usi un client VNC desktop.
    # ports:
    #   - "6080:6080"   # http://localhost:6080/vnc.html
    #   - "5901:5901"   # opzionale
