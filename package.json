{
  "name": "shri-tools",
  "version": "4.0.1",
  "private": true,
  "description": "SHRI tools",
  "author": "ExUs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win portable",
    "dist": "electron-builder --linux AppImage --win portable"
  },
  "dependencies": {
    "create-torrent": "^6.1.0",
    "mediainfo.js": "^0.3.7"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0"
  },
 "build": {
    "appId": "com.exus.shri-tools",
    "productName": "SHRI-Tools",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icons/app.ico",
      "target": [
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/icons",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "files": [
      "assets/icons/**/*",
      "app/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ]
  }
}
